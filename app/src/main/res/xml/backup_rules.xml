<?xml version="1.0" encoding="utf-8"?>
<!--
    Reglas de copia para Android 11 y anteriores.

    Mismo criterio que en data_extraction_rules.xml: los contratos firmados y
    las fotos de los clientes no suben a la copia automática. Aquí no existe
    la distinción entre nube y traspaso directo, así que se excluye la base de
    datos entera.
-->
<full-backup-content>
    <exclude domain="database" path="studio_database" />
    <exclude domain="database" path="studio_database-shm" />
    <exclude domain="database" path="studio_database-wal" />
</full-backup-content>
