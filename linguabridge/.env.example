# Copia este archivo como .env (opcional). Todo funciona sin él.
# Servidor local de LinguaBridge
LINGUABRIDGE_PORT=8788
LINGUABRIDGE_HOST=127.0.0.1
# IA local con Ollama (opcional)
OLLAMA_URL=http://127.0.0.1:11434
LINGUABRIDGE_OLLAMA_MODEL=qwen3.5:4b
# Otro servidor compatible con la API de OpenAI (LM Studio, llama.cpp, vLLM...). Opcional.
# LINGUABRIDGE_LLM=openai
# LINGUABRIDGE_OPENAI_URL=http://127.0.0.1:1234/v1
# LINGUABRIDGE_OPENAI_MODEL=nombre-del-modelo
# LINGUABRIDGE_OPENAI_KEY=
