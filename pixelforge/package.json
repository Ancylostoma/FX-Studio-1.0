{
  "name": "pixelforge-studio",
  "version": "1.0.0",
  "description": "Generador de Pixel Art por código: prompt → PixelScene → Canvas",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node server/server.mjs",
