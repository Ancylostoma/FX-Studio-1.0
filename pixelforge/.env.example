# Configuración opcional de PixelForge Studio. Copia este archivo como .env.
# Sin .env todo funciona con los valores por defecto.

# --- IA local (Ollama) ---
# Dirección de Ollama (por defecto http://127.0.0.1:11434)
OLLAMA_URL=
# Modelo por defecto (por defecto qwen3.5:4b)
PIXELFORGE_OLLAMA_MODEL=
# Otro equipo de la red local con Ollama, autorizado expresamente (host:puerto)
PIXELFORGE_OLLAMA_HOSTS=

# --- Servidor de PixelForge ---
PORT=8787
# Solo este equipo por defecto. 0.0.0.0 lo abre a la red local (p. ej. el móvil).
PIXELFORGE_HOST=

# --- Nube (DESACTIVADA) ---
# PixelForge no usa servicios de pago. El adaptador de Claude se conserva
# inactivo: solo funcionaría con PIXELFORGE_ENABLE_CLOUD=1 y una clave.
PIXELFORGE_ENABLE_CLOUD=
ANTHROPIC_API_KEY=
